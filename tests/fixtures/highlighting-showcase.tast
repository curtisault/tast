# Highlighting showcase — exercises every syntax construct in the TAST grammar.
# Used for manual visual verification of syntax highlighting in editors.

# --- Imports ---

import Auth from "./importable_auth.tast"

# --- Graphs ---

graph HighlightingShowcase {

  # --- Fixtures ---

  fixture AdminUser {
    role: "admin"
    email: "admin@example.com"
    active: true
    score: null
  }

  fixture GuestUser {
    role: "guest"
    active: false
  }

  # --- Nodes with all step types ---

  node RegisterUser {
    describe "A new user registers with valid credentials"

    given a user with {
      email: "test@example.com"
      password: "secure123"
    }

    when the user submits the registration form
    then the system creates a new account
    and the user receives a confirmation email
    but no duplicate accounts are created

    tags [smoke, critical, regression]
    config { timeout: "30s" }
  }

  node LoginUser {
    describe "A registered user logs in"

    given a registered user with email "test@example.com"
    when the user submits valid credentials
    then the system returns an auth token
    and the session is active
  }

  # --- Node with parameter placeholders ---

  node ParameterizedLogin {
    describe "Login with parameterized credentials"

    given a user with email <email> and password <password>
    when the user submits the login form
    then the system authenticates as <username>
  }

  # --- Nodes for edge demonstration ---

  node AccessDashboard {
    describe "An authenticated user accesses the dashboard"

    given an active session
    when the user navigates to the dashboard
    then the dashboard loads with user-specific data
  }

  node LogoutUser {
    describe "A user logs out"

    given an active session
    when the user clicks logout
    then the session is destroyed
    and the user is redirected to the login page
  }

  # --- Edges ---

  RegisterUser -> LoginUser {
    passes { user_id, email }
    describe "After registration, the user can log in"
  }

  LoginUser -> AccessDashboard {
    passes { auth_token, session_id }
    describe "Login grants access to protected routes"
  }

  LoginUser -> LogoutUser {
    passes { session_id }
    describe "A logged-in user can log out"
  }

  # --- Cross-graph edge (references imported graph) ---

  Auth.Login -> AccessDashboard {
    passes { auth_token }
    describe "External auth grants dashboard access"
  }

  # --- Graph-level config ---

  config {
    timeout: "60s"
    retries: "3"
  }
}
